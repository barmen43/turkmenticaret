{
  "headers": [
    {
      "source": "/(sw\\.js|registerSW\\.js|index\\.html|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|sw\\.js|workbox-.*\\.js|registerSW\\.js|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
